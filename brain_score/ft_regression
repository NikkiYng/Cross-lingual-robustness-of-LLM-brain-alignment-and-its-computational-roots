def fisher_transform(r):
    """ Fisher transformation to correlation coefficient."""
    return 0.5 * np.log((1 + r) / (1 - r))

def p_adjust_bh(p):
    """Benjamini-Hochberg p-value correction for multiple hypothesis testing."""
    p = np.asfarray(p)
    by_descend = p.argsort()[::-1]
    by_orig = by_descend.argsort()
    steps = float(len(p)) / np.arange(len(p), 0, -1)
    q = np.minimum(1, np.minimum.accumulate(steps * p[by_descend]))
    return q[by_orig]

def load_time_series_from_rois(time_series):
    """Load the time series data from the 'ts' key."""
    if 'ts' in time_series:
        ts = time_series['ts']
        print(f"Time series shape from 'ts': {ts.shape}")
        return ts
    else:
        raise KeyError("'ts' key not found in the .mat file.")

def cross_val(var, save_file_path_cv=None, save_file_path_thred=None):
    rigid_cv_dicts = {}

    # 1. Iterate over each subject folder
    for sub in tqdm(SubList, desc="Processing Subjects"):
        subject_dir = f'{ts_dir}{sub}/'

        # Get the list of fMRI run files for this subject and sort by run number
        all_runs = [f for f in os.listdir(subject_dir) if '_Schaefer400_TianS1_denoised' in f]

        # Sort runs by the original run number from the filenames
        all_runs_sorted = sorted(all_runs, key=lambda x: int(re.search(r'run-(\d+)', x).group(1)))
        run_file_map = {i + 1: run_file for i, run_file in enumerate(all_runs_sorted)}
        
        # Create a mapping from fMRI run_ids to sequential numbers (1-9) based on their order
        run_id_mapping = {original_run_id: i + 1 for i, original_run_id in enumerate(sorted(run_file_map.keys()))}

        # Collect embeddings and fMRI data for each run for the subject
        X = []  # Holds all aligned embeddings across runs
        Y = []  # Holds all fMRI time series across runs
        
        for i, (fmri_run_id, run_file) in enumerate(run_file_map.items(), start=1):
            # Map the original fMRI `run_id` to a sequential `run_id` for embeddings
            embedding_run_id = run_id_mapping[fmri_run_id]
            print(f'Subject: {sub}, Re-mapped Run: {embedding_run_id}, Original fMRI Run ID: {fmri_run_id}, File: {run_file}')
            file_path = f'{subject_dir}{run_file}'

            # Load the fMRI time series for this run
            time_series = loadmat(file_path)
            try:
                ts = load_time_series_from_rois(time_series)
            except KeyError as e:
                print(f"Error loading time series for {sub}, run {fmri_run_id}: {e}")
                continue

            # Preprocess the fMRI data
            df_run = df[df['run_id'] == embedding_run_id]  # Filter embeddings for this run
            discard_start = int(np.floor(df_run['offset'].tolist()[0] / tr))
            ts = ts[discard_start:, :]         
            ts = fmri_pipe.fit_transform(ts) 
            nscans = [ts.shape[0]]
   
            # Load and preprocess embeddings for the remapped `embedding_run_id`
            gentles = df_run['offset'].values.tolist()  # Get offsets specific to this run
            gentles = [[gentle - tr * int(np.floor(df_run['offset'].tolist()[0] / tr)) for gentle in gentles]]
  
            # Extract embeddings for the current run
            embeddings = np.array(df_run[var].tolist())

            # Align embeddings with fMRI time points
            aligned_embeddings = features_pipe.fit_transform(
                np.vstack(embeddings),
                encoding_method=encoding_method,
                tr=tr,
                groups=get_groups(gentles),
                gentles=gentles,
                nscans=nscans
            )
            print(f"Aligned-embs {sub}, run {embedding_run_id}: {aligned_embeddings.shape}")
            # Append aligned data for cross-validation later
            X.append(aligned_embeddings)
            Y.append(ts)

        # 2. Check if we have enough runs to perform Leave-P-Out
        num_runs = len(X)
        if num_runs < 3:
            print(f"Not enough runs for cross-validation for subject {sub}, skipping...")
            continue

        # 3. Perform cross-validation across all runs for the subject
        logo = LeavePOut(1)
        scores = []

        for train, test in logo.split(range(num_runs)):  # Split across run indices
            encoder = Encoder(linearmodel=linearmodel, saving_folder=None, **encoding_params)
            
            # Stack training and test data across the specified runs
            y_train = np.vstack([Y[i] for i in train])
            X_train = np.vstack([X[i] for i in train])
            y_test = np.vstack([Y[i] for i in test])
            X_test = np.vstack([X[i] for i in test])
            print(f"X_train shape: {X_train.shape}, y_train shape: {y_train.shape}")

            # Fit and evaluate the model
            encoder.fit(X_train, y_train)
            test_predictions = encoder.predict(X_test)
            score = encoder.eval(test_predictions, y_test, axis=0)
            scores.append(score)

        # Compute mean score for this subject
        scores_mean = np.mean(scores, axis=0)
        if len(scores_mean.shape) == 1:
            scores_mean = scores_mean.reshape(1, -1)
        rigid_cv_dicts[f'{sub}'] = scores_mean

    # 2. Combine all cross-validation results into a single array
    group_cv = np.vstack(list(rigid_cv_dicts.values()))

    if save_file_path_cv is not None:
        np.save(save_file_path_cv, group_cv)
        print(f'group_cv saved as {save_file_path_cv}.npy')

    # 3. Perform T-tests and FDR correction
    p_values = []
    for i in trange(n_rois, desc="Performing T-tests for each ROI"):
        t_stat, p_value = stats.ttest_1samp(group_cv[:, i], 0, alternative='greater')
        p_values.append(p_value)
    qs = p_adjust_bh(p_values)
    rs = np.mean(group_cv, axis=0)
    thred_rs = np.where(qs < 0.05, rs, np.nan)
    if save_file_path_thred is not None:
        np.save(save_file_path_thred, thred_rs)
        print(f'thred_rs saved as {save_file_path_thred}.npy')
    
    return group_cv, thred_rs



