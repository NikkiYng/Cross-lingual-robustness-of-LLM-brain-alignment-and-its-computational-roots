# 1. Each network as a plot

def get_schaefer400_network_labels():
    """
    Returns a list of length 400, where each entry is the Yeo-7 network name
    (e.g. 'Vis', 'SomMot', 'DorsAttn', 'SalVentAttn', 'Limbic', 'Cont', 'Default')
    for that ROI index (1..400).
    """
    atlas = datasets.fetch_atlas_schaefer_2018(
        n_rois=400,
        yeo_networks=7,
        resolution_mm=2
    )
    labels = atlas.labels

    # Drop the first one: "Background"
    labels = atlas.labels[1:] 
    
    network_list = []
    possible_networks = [
        "Vis", "SomMot", "DorsAttn",
        "SalVentAttn", "Limbic", "Cont", "Default"
    ]

    for lab in labels:
        if isinstance(lab, bytes):
            lab = lab.decode("utf-8")
        lab = str(lab)

        parts = lab.split("_")
        net = None
        for p in parts:
            if p in possible_networks:
                net = p
                break
        if net is None:
            raise ValueError(f"Could not find network name in label: {lab}")
        network_list.append(net)

    if len(network_list) != 400:
        raise ValueError(f"Expected 400 labels, got {len(network_list)}")

    return network_list

def aggregate_scores_by_network(score_vec,
                                networks_400,
                                n_cortical=400,
                                n_subcort=16):
    """
    Parameters
    ----------
    score_vec : np.ndarray, shape (416,)
        First 400 = Schaefer-400 (cortical),
        last 16 = Tian subcortical.
    networks_400 : list of str, length 400
        Yeo network name for each Schaefer ROI.

    Returns
    -------
    mean_scores : dict
        Keys: 7 Yeo networks + 'Subcortical'
        Values: mean score for that network.
    """
    score_vec = np.asarray(score_vec)
    if score_vec.shape[0] < n_cortical + n_subcort:
        raise ValueError(
            f"score_vec has length {score_vec.shape[0]}, "
            f"expected at least {n_cortical + n_subcort}"
        )

    cortical_scores = score_vec[:n_cortical]
    subcort_scores = score_vec[n_cortical:n_cortical + n_subcort]

    # Collect scores for each network
    net_scores = defaultdict(list)
    for i, net in enumerate(networks_400):
        net_scores[net].append(cortical_scores[i])

    # Average over ROIs in each network (LH + RH pooled)
    mean_scores = {
        net: float(np.mean(vals)) for net, vals in net_scores.items()
    }

    # Average over the 16 Tian subcortical ROIs
    mean_scores["Subcortical"] = float(np.mean(subcort_scores))

    return mean_scores

def load_language_means(lang_name, lang_folder, networks_400):
    """
    lang_name : str, e.g. 'CN'
    lang_folder : folder containing group_cv_layer_*.npy
    networks_400 : list of Yeo-7 network labels for Schaefer-400

    Returns
    -------
    df : DataFrame
        index = layer number (int)
        columns = 7 networks + 'Subcortical'
    """
    pattern = os.path.join(lang_folder, "group_cv_layer_*.npy")
    files = sorted(glob.glob(pattern))

    rows = []
    layers = []

    for f in files:
        m = re.search(r"layer_(\d+)", os.path.basename(f))
        if not m:
            continue
        layer_num = int(m.group(1))

        scores = np.load(f)  # shape (34, 416) or (416,)
        
        # If it's (n_subj, 416), average over subjects
        if scores.ndim == 2:
            # axis=0 → mean across 34 subjects, result shape (416,)
            scores_mean = scores.mean(axis=0)
        else:
            scores_mean = scores  # already (416,)

        mean_scores = aggregate_scores_by_network(scores_mean, networks_400)

        layers.append(layer_num)
        rows.append(mean_scores)

    if not rows:
        raise RuntimeError(f"No matching npy files found in {lang_folder}")

    df = pd.DataFrame(rows, index=layers)
    df.index.name = "layer"
    df = df.sort_index()
    return df

