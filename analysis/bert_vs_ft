# 4. Permutation test
diff = bert - ft  # (subjects, 416)
obs_diff, p_perm = signflip_perm_test_streaming(diff, n_perm=10000, seed=42)
reject, p_fdr = fdrcorrection(p_perm, alpha=0.05)

bert_better = reject & (obs_diff > 0)
ft_better   = reject & (obs_diff < 0)

print("Significant (FDR):", int(reject.sum()))
print("BERT > FT:", int(bert_better.sum()))
print("FT > BERT:", int(ft_better.sum()))

